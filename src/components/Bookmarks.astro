---
---

<section class="bookmark-manager" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="bookmark-field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit" class="add-bookmark">Add bookmark</button>
  </form>

  <p class="bookmark-hint">Add a web address with or without <code>https://</code>. Mona will give it a short, shareable slug.</p>
  <p id="bookmark-status" class="bookmark-status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="bookmark-empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" class="bookmark-list-header" hidden>
    <h2 class="bookmark-list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="bookmark-clear">Clear all</button>
  </div>

  <ul id="bookmark-list" class="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import {
    createBookmarkSlug,
    decodeBookmarks,
    formatBookmark,
    normalizeBookmarkUrl,
    STORAGE_KEY,
  } from '../lib/bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const status = document.getElementById('bookmark-status');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const bookmarkList = document.getElementById('bookmark-list');
  const clearAll = document.getElementById('clear-all');
  let bookmarks = [];

  function showMessage(message, type = 'info') {
    status.textContent = message;
    status.dataset.state = type;
  }

  function renderBookmarks() {
    bookmarkList.replaceChildren();

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark-row';

      const value = document.createElement('div');
      value.className = 'bookmark-value';

      const link = document.createElement('a');
      link.className = 'bookmark-url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'bookmark-separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('code');
      slug.className = 'bookmark-slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'bookmark-copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showMessage(`Copied ${bookmark.slug} to the clipboard.`);
        } catch {
          showMessage('Could not copy the slug. Check clipboard permissions and try again.', 'error');
        }
      });

      value.append(link, separator, slug);
      item.append(value, copy);
      bookmarkList.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  try {
    bookmarks = decodeBookmarks(window.localStorage.getItem(STORAGE_KEY));
  } catch {
    showMessage('Saved bookmarks are unavailable because browser storage could not be read.', 'error');
  }
  renderBookmarks();

  form.addEventListener('submit', (event) => {
    event.preventDefault();

    let url;
    try {
      url = normalizeBookmarkUrl(urlInput.value);
    } catch {
      showMessage('Enter a valid web address, such as example.com.', 'error');
      urlInput.focus();
      return;
    }

    try {
      let slug = createBookmarkSlug();
      while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
        slug = createBookmarkSlug();
      }

      const nextBookmarks = [...bookmarks, { url, slug }];
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(nextBookmarks));
      bookmarks = nextBookmarks;
      renderBookmarks();
      form.reset();
      showMessage(`Saved ${formatBookmark({ url, slug })}.`);
    } catch {
      showMessage('Could not save this bookmark. Check browser storage and try again.', 'error');
    }
  });

  clearAll.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks from this device?')) return;

    try {
      window.localStorage.removeItem(STORAGE_KEY);
      bookmarks = [];
      renderBookmarks();
      showMessage('All bookmarks cleared.');
    } catch {
      showMessage('Could not clear saved bookmarks. Check browser storage and try again.', 'error');
    }
  });
</script>

<style is:global>
  .bookmark-manager {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background: color-mix(in srgb, var(--accent) 4%, Canvas);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 8%, transparent);
  }

  .bookmark-manager form {
    gap: 0.75rem;
    margin: 0 0 0.75rem;
  }

  .bookmark-field {
    display: flex;
    flex: 1 1 16rem;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bookmark-field label {
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .bookmark-field input {
    width: 100%;
    min-width: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: Canvas;
    color: CanvasText;
    font: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .bookmark-field input:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
    outline: none;
  }

  .bookmark-manager button {
    font: inherit;
    cursor: pointer;
    transition: transform 150ms ease, filter 150ms ease, border-color 150ms ease;
  }

  .bookmark-manager button:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .bookmark-manager button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .bookmark-manager .add-bookmark {
    padding: 0.75rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    white-space: nowrap;
  }

  .bookmark-hint {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .bookmark-hint code {
    font-family: var(--font-body);
    color: inherit;
  }

  .bookmark-status {
    min-height: 1.25rem;
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .bookmark-status[data-state='error'] {
    color: #dc2626;
  }

  .bookmark-empty {
    margin: 0;
    padding: 1.5rem 1rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }

  .bookmark-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.75rem 0 0.5rem;
  }

  .bookmark-list-header[hidden] {
    display: none;
  }

  .bookmark-list-title {
    margin: 0;
    font-family: var(--font-head);
    font-size: 1rem;
  }

  .bookmark-manager .bookmark-clear,
  .bookmark-manager .bookmark-copy {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .bookmark-manager .bookmark-clear:hover,
  .bookmark-manager .bookmark-copy:hover {
    border-color: currentColor;
  }

  .bookmark-list {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bookmark-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, Canvas 70%, transparent);
  }

  .bookmark-value {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .bookmark-url {
    overflow-wrap: anywhere;
  }

  .bookmark-separator {
    white-space: pre;
  }

  .bookmark-slug {
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    font-family: var(--font-body);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  @media (max-width: 32rem) {
    .bookmark-manager {
      padding: 1rem;
    }

    .bookmark-manager .add-bookmark {
      width: 100%;
    }

    .bookmark-row {
      align-items: flex-start;
    }
  }
</style>
